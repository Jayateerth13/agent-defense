# Copy to .env and fill in ONE of the two keys. Never commit .env.
OPENAI_API_KEY=
# GOOGLE_API_KEY=

# Policy LLM. The official Progent setup uses gpt-4o; mini models returned empty policies in our probe.
PROGENT_POLICY_MODEL=gpt-4o

# Optional: agent LLM. Defaults to gpt-4o-mini if OPENAI_API_KEY is set, else a Gemini model if GOOGLE_API_KEY is set.
# Also used for the policy LLM when PROGENT_POLICY_MODEL is not set.
# PROGENT_MODEL=gpt-4o-mini

# Optional: reasoning effort passed to the API (none/low/medium/high).
# PROGENT_REASONING_EFFORT=low

# Optional: discard policy expansions instead of auto-approving them.
# PROGENT_ONLY_ALLOW_NARROW=True

# Optional: custom OpenAI-compatible endpoint.
# PROGENT_BASE_URL=
